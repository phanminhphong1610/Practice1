#include <Arduino.h>

#define PIN_BUTTON 2 // Chân PD2 nối nút nhấn SW1
#define PIN_LED    3 // Chân PD3 nối LED R1

// Biến lưu trạng thái
bool ledState = false;       // Trạng thái hiện tại của LED (false = TẮT, true = SÁNG)
bool lastButtonState = HIGH; // Trạng thái nút nhấn ở lần đọc trước đó

void setup() {
  Serial.begin(115200);

  // Khai báo nút nhấn có trở kéo lên nội (Thả = HIGH, Nhấn = LOW)
  pinMode(PIN_BUTTON, INPUT_PULLUP);
  
  // Khai báo LED
  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW); // Ban đầu tắt LED

  Serial.println("=== GPIO TOGGLE LED READY ===");
}

void loop() {
  // Đọc trạng thái hiện tại của nút bấm
  bool currentButtonState = digitalRead(PIN_BUTTON);

  // Phát hiện CẠNH XUỐNG: Nút vừa được nhấn (chuyển từ thả HIGH sang nhấn LOW)
  if (lastButtonState == HIGH && currentButtonState == LOW) {
    delay(20); // Chống dội phím (Debounce delay 20ms)

    // Xác nhận lại xem nút có thực sự đang được nhấn không
    if (digitalRead(PIN_BUTTON) == LOW) {
      // Đảo ngược trạng thái LED (Đang Tắt -> Sáng, Đang Sáng -> Tắt)
      ledState = !ledState; 
      digitalWrite(PIN_LED, ledState ? HIGH : LOW);

      // In thông báo ra Serial Monitor để kiểm tra
      Serial.print("[GPIO] Button Pressed! LED Status: ");
      Serial.println(ledState ? "ON" : "OFF");
    }
  }

  // Cập nhật trạng thái nút nhấn cho vòng lặp tiếp theo
  lastButtonState = currentButtonState;
}
