#include <Arduino.h>

// 1. CẤU HÌNH CHÂN NỐI
#define PIN_PIR       2 // Cọc OUT của Khối CB PIR nối chân PD2 (Digital 2)
#define PIN_LED_ALARM 3 // Cọc R1 của Khối LED đơn nối chân PD3 (Digital 3)

// 2. CẤU HÌNH THỜI GIÁN BẢO TRÌ & LỌC NHIỄU
const unsigned long PIR_WARMUP_TIME = 30000; // 30 giây chờ PIR ổn định điện áp ban đầu
const unsigned long SERIAL_INTERVAL  = 500;   // In Serial Monitor mỗi 500ms
const unsigned long LED_BLINK_SPEED  = 150;   // Tốc độ LED nhấp nháy (ms)

// Biến quản lý trạng thái
bool pirState = LOW;             // Trạng thái hiện tại của PIR
bool isWarmedUp = false;         // Cờ xác nhận PIR đã khởi động xong
unsigned long lastSerialTime = 0;
unsigned long lastBlinkTime = 0;
bool ledState = LOW;

void setup() {
  Serial.begin(115200);

  // Cấu hình chân vào/ra
  pinMode(PIN_PIR, INPUT);
  pinMode(PIN_LED_ALARM, OUTPUT);
  digitalWrite(PIN_LED_ALARM, LOW);

  Serial.println("==========================================");
  Serial.println("[PIR SYSTEM] DANG KHOI DONG CAM BIEN PIR...");
  Serial.println("[NOTE] Vui long cho 30s de cam bien on dinh!");
  Serial.println("==========================================");
}

void loop() {
  unsigned long currentMillis = millis();

  // BƯỚC 1: KIỂM TRA THỜI GIÁN KHỞI ĐỘNG (WARM-UP)
  if (!isWarmedUp) {
    if (currentMillis >= PIR_WARMUP_TIME) {
      isWarmedUp = true;
      Serial.println("\n[PIR SYSTEM] CAM BIEN DA SAN SANG HOAT DONG!\n");
    } else {
      // Trong 30s đầu: Ép tắt LED và ngưng đọc tín hiệu để tránh báo giả
      digitalWrite(PIN_LED_ALARM, LOW);
      
      if (currentMillis - lastSerialTime >= 1000) {
        lastSerialTime = currentMillis;
        Serial.print("[WARM-UP] Con lai: ");
        Serial.print((PIR_WARMUP_TIME - currentMillis) / 1000);
        Serial.println(" giay...");
      }
      return; // Bỏ qua phần xử lý bên dưới cho đến khi hết 30s
    }
  }

  // BƯỚC 2: ĐỌC TÍN HIỆU TỪ CẢM BIẾN PIR
  int currentPirReading = digitalRead(PIN_PIR);

  // BƯỚC 3: XỬ LÝ TRẠNG THÁI VÀ ĐIỀU KHIỂN LED
  if (currentPirReading == HIGH) {
    // KHI CÓ CHUYỂN ĐỘNG: LED NHẤP NHÁY
    if (currentMillis - lastBlinkTime >= LED_BLINK_SPEED) {
      lastBlinkTime = currentMillis;
      ledState = !ledState;
      digitalWrite(PIN_LED_ALARM, ledState);
    }
  } else {
    // KHI KHÔNG CÓ CHUYỂN ĐỘNG: TẮT LED HẲN
    digitalWrite(PIN_LED_ALARM, LOW);
    ledState = LOW;
  }

  // BƯỚC 4: GỬI TRẠNG THÁI NÊN SERIAL MONITOR MỖI 500MS
  if (currentMillis - lastSerialTime >= SERIAL_INTERVAL) {
    lastSerialTime = currentMillis;

    Serial.print("[PIR MONITOR] Motion: ");
    if (currentPirReading == HIGH) {
      Serial.print("DETECTED (CO CHUYEN DONG)");
      Serial.println(" | LED: BLINKING");
    } else {
      Serial.print("CLEAR    (KHONG CO CHUYEN DONG)");
      Serial.println(" | LED: OFF");
    }
  }
}
